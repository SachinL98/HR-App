# Copy to .env (never commit the real one). Every value below must be changed for production.

# --- API (apps/api) ---
NODE_ENV=production
PORT=4000
# At least 32 random characters:  openssl rand -base64 48
JWT_SECRET=
# 32 random bytes, base64. LOSING THIS KEY MAKES SALARIES, NATIONAL IDS AND FILES UNREADABLE. Back it up separately.
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Restricted role, row-level security enforced (create roles with real passwords; see README "Going to production").
DATABASE_URL=postgresql://hr_app:CHANGE_ME@db-host:5432/hr
# Login and invite lookups only (bypasses row-level security).
DATABASE_SYSTEM_URL=postgresql://hr_system:CHANGE_ME@db-host:5432/hr
# Email (any SMTP provider: Amazon SES, Zoho, SendGrid, Mailgun...). Invites, password resets and email
# confirmation are sent through it. The API will not start in production without it.
SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
MAIL_FROM="Seamless Source HR <no-reply@example.com>"
# ALLOW_NO_MAIL=true   # only to start without email (invites then cannot be delivered)

# Billing. Your payment provider (or a small adapter in front of it) calls POST /billing/webhook with a body
# signed using HMAC-SHA256 and this secret (header x-signature). Leave empty to switch the endpoint off.
BILLING_WEBHOOK_SECRET=

# Public address of the web app (CORS and invite links).
WEB_URL=https://hr.example.com
# Persistent, backed-up folder or volume for generated documents and letterheads.
# Where encrypted files are kept: 'disk' (FILE_STORAGE_DIR, a persistent volume) or 'db' (default on Vercel).
# FILE_STORAGE=db
FILE_STORAGE_DIR=/var/lib/hr/files
# Vercel only: protects GET /cron/reminders (Vercel Cron sends it automatically).
# CRON_SECRET=
# Per-address requests per minute (raise to 3000 when all traffic comes from one front end). DB_POOL_MAX caps connections per instance.
# THROTTLE_LIMIT=300
# DB_POOL_MAX=2
# How many proxy hops sit in front of the API (so rate limits see real visitor addresses).
TRUST_PROXY=1

# --- Web (apps/web) ---
API_URL=http://api:4000
# Shown on the Plan and billing page as the place to ask for a plan change.
BILLING_CONTACT_EMAIL=billing@example.com
# Public address of the API, used in the calendar subscription link (defaults to API_URL).
PUBLIC_API_URL=https://api.hr.example.com

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_API_URL=https://api.hr.example.com
# Where the web app lives, for "Forgot password" and security settings opened from the app.
EXPO_PUBLIC_WEB_URL=https://hr.example.com
