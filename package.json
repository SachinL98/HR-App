{
  "name": "hr-app",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev -w @hr/web",
    "dev:api": "npm run start:dev -w @hr/api",
    "dev:mobile": "npm run start -w @hr/mobile",
    "build": "npm run build -w @hr/web && npm run build -w @hr/api",
    "lint": "npm run lint -w @hr/web",
    "test": "npm test -w @hr/api",
    "db:validate": "npm run validate -w @hr/db",
    "db:migrate": "npm run migrate -w @hr/db"
  }
}
